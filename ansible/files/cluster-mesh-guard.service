[Unit]
Description=Keep cluster machine protocols and workload ports off the public interface
DefaultDependencies=no
After=systemd-sysctl.service
Wants=network-pre.target
Before=network-pre.target shutdown.target docker.service consul.service nomad.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/cluster-mesh-guard.nft
ExecReload=/usr/sbin/nft -f /etc/cluster-mesh-guard.nft
ExecStop=/usr/sbin/nft destroy table inet cluster_mesh_guard

[Install]
WantedBy=multi-user.target
