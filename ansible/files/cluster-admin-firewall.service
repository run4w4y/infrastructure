[Unit]
Description=Keep native cluster APIs, RPC and DNS private
DefaultDependencies=no
After=systemd-sysctl.service
Wants=network-pre.target
Before=network-pre.target shutdown.target docker.service consul.service nomad.service vault.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/cluster-admin.nft
ExecReload=/usr/sbin/nft -f /etc/cluster-admin.nft
ExecStop=/usr/sbin/nft destroy table inet cluster_admin

[Install]
WantedBy=multi-user.target
